# Copy to .env or export these variables in your shell.
# Do not commit real credentials.

AUTODEV_PROVIDER=codex_cli

# Codex uses your existing ChatGPT login; do not put login tokens in this file.
AUTODEV_CODEX_EXECUTABLE=codex
AUTODEV_CODEX_TIMEOUT_SECONDS=180
AUTODEV_CODEX_MAX_OUTPUT_BYTES=1000000

# Only needed if you explicitly install/select the optional paid openai_api backend.
# OPENAI_API_KEY=

# Leave empty for the selected provider's default, or set a model available to your account.
AUTODEV_DEVELOPER_MODEL=
AUTODEV_REVIEWER_MODEL=

# Safety and cost controls. Codex uses the estimates as a call-count guard, not API billing.
AUTODEV_MAX_ITERATIONS=3
AUTODEV_API_BUDGET_USD=1.00
AUTODEV_ESTIMATED_COST_PER_MODEL_CALL_USD=0.05

# Execution backend. Use dry_run unless Docker is installed and acceptable for your threat model.
AUTODEV_SANDBOX_BACKEND=dry_run
AUTODEV_DOCKER_IMAGE=autodev-sandbox:py311

# Generated files are only written below this directory.
AUTODEV_WORKSPACE=.autodev/workspace

# Opt-in parallel workflow: pass --parallel. Two concurrent developers maximum.
AUTODEV_CONCURRENCY=2
AUTODEV_MAX_TASKS=4
AUTODEV_MAX_CORRECTIONS=3
AUTODEV_MAX_MODEL_CALLS=24
AUTODEV_WORKFLOW_TIMEOUT_SECONDS=1800
AUTODEV_AGENT_TIMEOUT_SECONDS=240
AUTODEV_GIT_TIMEOUT_SECONDS=30
